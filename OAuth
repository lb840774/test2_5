import boto3
from botocore.exceptions import ClientError

control = boto3.client("bedrock-agentcore-control", region_name=AWS_REGION)

try:
    resp = control.create_workload_identity(
        name=WORKLOAD_NAME,
        tags={"purpose": "identity-smoke-test"},
    )
    print("Workload identity created.")
    print("workloadIdentityArn:", resp.get("workloadIdentityArn"))
except ClientError as e:
    code = e.response["Error"]["Code"]
    # If it already exists, that's fine
    if code in ("ConflictException", "ValidationException"):
        print(f"Workload identity likely already exists; continuing. ({code})")
    else:
        raise

