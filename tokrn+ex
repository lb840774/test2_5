import json

def lambda_handler(event, context):
    print("EVENT:", json.dumps(event))

    args = event.get("arguments", {})
    a = args.get("a")
    b = args.get("b")

    if a is None or b is None:
        return {
            "statusCode": 400,
            "body": json.dumps({"error": "Missing a or b"})
        }

    return {
        "statusCode": 200,
        "body": json.dumps({
            "result": a + b
        })
    }




