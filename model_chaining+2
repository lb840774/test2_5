def build_model_tar(stage_name: str, model_obj, inference_py: str, out_dir: Path) -> Path:
    out_dir.mkdir(exist_ok=True, parents=True)
    stage_dir = out_dir / stage_name
    code_dir = stage_dir / "code"
    code_dir.mkdir(parents=True, exist_ok=True)

    # save model
    joblib.dump(model_obj, stage_dir / "model.joblib")

    # write inference in BOTH places (root + code/)
    (stage_dir / "inference.py").write_text(inference_py)
    (code_dir / "inference.py").write_text(inference_py)

    # ensure package import works
    (code_dir / "__init__.py").write_text("")

    tar_path = out_dir / f"{stage_name}.tar.gz"
    if tar_path.exists():
        tar_path.unlink()

    with tarfile.open(tar_path, "w:gz") as tar:
        tar.add(stage_dir / "model.joblib", arcname="model.joblib")
        tar.add(code_dir / "inference.py", arcname="code/inference.py")
        tar.add(code_dir / "__init__.py", arcname="code/__init__.py")
        tar.add(stage_dir / "inference.py", arcname="inference.py")  # fallback

    return tar_path

artifacts_dir = Path("./artifacts")
tar1 = build_model_tar("stage1", m1, INFERENCE_STAGE1, artifacts_dir)
tar2 = build_model_tar("stage2", m2, INFERENCE_STAGE2, artifacts_dir)
tar3 = build_model_tar("stage3", m3, INFERENCE_STAGE3, artifacts_dir)

print("Built:", tar1, tar2, tar3)

# sanity check
import tarfile
for t in [tar1, tar2, tar3]:
    with tarfile.open(t, "r:gz") as tf:
