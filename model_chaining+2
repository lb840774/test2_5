def ensure_mpg(name: str):
    try:
        sm.describe_model_package_group(ModelPackageGroupName=name)
        print("MPG exists:", name)
    except sm.exceptions.ClientError:
        sm.create_model_package_group(
            ModelPackageGroupName=name,
            ModelPackageGroupDescription=f"Demo MPG for {name}"
        )
        print("Created MPG:", name)

ensure_mpg(mpg1)
ensure_mpg(mpg2)
ensure_mpg(mpg3)

def register_model_package(stage: str, mpg: str, model_data_url: str, extra_meta: dict):
    resp = sm.create_model_package(
        ModelPackageGroupName=mpg,
        ModelPackageDescription=f"{stage} of 3-stage LR inference pipeline",
        InferenceSpecification={
            "Containers": [{
                "Image": inference_image,
                "ModelDataUrl": model_data_url,
                "Environment": {
                    "SAGEMAKER_PROGRAM": "inference.py",
                    "SAGEMAKER_SUBMIT_DIRECTORY": model_data_url,
                    "SAGEMAKER_CONTAINER_LOG_LEVEL": "20",
                    "SAGEMAKER_REGION": region,
                }
            }],
            "SupportedContentTypes": ["text/csv"],
            "SupportedResponseMIMETypes": ["text/csv"]
        },
        ModelApprovalStatus="Approved",
        CustomerMetadataProperties={
            "ChainId": chain_id,
            "Stage": stage,
            **{k: str(v) for k, v in extra_meta.items()}
        }
    )
    return resp["ModelPackageArn"]

mp1_arn = register_model_package("stage1", mpg1, s3_stage1, extra_meta={})
