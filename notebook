import os
import shutil
import zipfile
import subprocess

# clean
shutil.rmtree("deployment_package", ignore_errors=True)
os.makedirs("deployment_package", exist_ok=True)

# install dependencies into package folder
subprocess.run(
    ["python", "-m", "pip", "install", "--target", "deployment_package", "requests", "bedrock-agentcore"],
    check=True
)

# copy main.py into package root
shutil.copy("runtime_forwarder/main.py", "deployment_package/main.py")

# zip everything
zip_name = "runtime_forwarder.zip"
with zipfile.ZipFile(zip_name, "w", zipfile.ZIP_DEFLATED) as z:
    for root, dirs, files in os.walk("deployment_package"):
        for f in files:
            full = os.path.join(root, f)
            arc = os.path.relpath(full, "deployment_package")
            z.write(full, arc)

print("Created", zip_name)






