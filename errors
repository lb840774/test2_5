  # SageMaker sometimes sends application/json or adds charset to text/csv
    if response_content_type is None:
        response_content_type = "text/csv"

    rct = response_content_type.lower()

    if rct.startswith("application/json"):
        response_content_type = "text/csv"

    if rct.startswith("text/csv"):
        response_content_type = "text/csv"

    if response_content_type != "text/csv":
        raise ValueError(f"Unsupported accept type: {response_content_type}")

    buf = io.StringIO()
    np.savetxt(buf, prediction, delimiter=",", fmt="%.6f")
    return buf.getvalue(), "text/csv"
