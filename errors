

import json
import base64

EXPECTED_AUD = "https://api.addition.example.com"
EXPECTED_SCOPE = "calc:add"

def decode_jwt_no_verify(token: str):
    try:
        parts = token.split(".")
        if len(parts) != 3:
            return {"warning": "not a JWT"}

        payload_b64 = parts[1] + "=" * (-len(parts[1]) % 4)
        payload = base64.urlsafe_b64decode(payload_b64.encode("utf-8"))
        return json.loads(payload.decode("utf-8"))
    except Exception as e:
        return {"warning": f"unable to decode token: {str(e)}"}

def lambda_handler(event, context):
    print("RAW EVENT:", json.dumps(event))
    print("EVENT KEYS:", list(event.keys()) if isinstance(event, dict) else "not a dict")

    if isinstance(event, dict) and "params" in event:
        print("EVENT PARAMS:", json.dumps(event.get("params", {})))

    if isinstance(event, dict) and "arguments" in event:
        print("EVENT ARGUMENTS:", json.dumps(event.get("arguments", {})))

    args = {}

    if isinstance(event, dict):
        if "arguments" in event and isinstance(event["arguments"], dict):
            args = event["arguments"]
        elif "params" in event and isinstance(event["params"], dict):
            args = event["params"].get("arguments", {})
        else:
            args = event

    print("PARSED_ARGS:", json.dumps(args))
    print("ARGS KEYS:", list(args.keys()) if isinstance(args, dict) else "not a dict")

    a = args.get("a")
    b = args.get("b")
    exchanged_token = args.get("exchanged_token")

    if a is None or b is None:
        return {
            "statusCode": 400,
            "body": json.dumps({
                "error": "Missing a or b",
                "received_event": event,
                "parsed_args": args
            })
        }

    if not exchanged_token:
        return {
            "statusCode": 401,
            "body": json.dumps({
                "error": "Missing exchanged_token",
                "received_event": event,
                "parsed_args": args
            })
        }

    claims = decode_jwt_no_verify(exchanged_token)
    print("EXCHANGED TOKEN CLAIMS AT BACKEND:", json.dumps(claims))

    aud = claims.get("aud")
    scope = claims.get("scope", "")

    aud_ok = aud == EXPECTED_AUD or (isinstance(aud, list) and EXPECTED_AUD in aud)
    scope_ok = EXPECTED_SCOPE in scope.split()

    if not aud_ok:
        return {
            "statusCode": 403,
            "body": json.dumps({
                "error": "Invalid audience",
                "received_aud": aud,
                "received_scope": scope
            })
        }

    if not scope_ok:
        return {
            "statusCode": 403,
            "body": json.dumps({
                "error": "Missing required scope",
                "received_aud": aud,
                "received_scope": scope
            })
        }

    return {
        "statusCode": 200,
        "body": json.dumps({
            "result": a + b,
            "validated_backend_token": True,
            "received_aud": aud,
            "received_scope": scope
        })
    }
