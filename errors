import boto3, json, uuid

REGION = "us-east-1"
RUNTIME_ARN = "arn:aws:bedrock-agentcore:us-east-1:196856463470:runtime/hosted_agent_cjrmc-ZWwHuAHZG8"

client = boto3.client("bedrock-agentcore", region_name=REGION)

def invoke(payload: dict):
    resp = client.invoke_agent_runtime(
        agentRuntimeArn=RUNTIME_ARN,
        runtimeSessionId=str(uuid.uuid4()),  # must be 33+ chars per console note
        payload=json.dumps(payload).encode("utf-8"),
        contentType="application/json",
        accept="application/json",
        # qualifier OMITTED on purpose -> DEFAULT endpoint used
    )
    body = resp["response"].read()
    return json.loads(body.decode("utf-8"))

print(invoke({"name": "list_tools"}))
