import boto3, json, uuid

rt = boto3.client("bedrock-agentcore", region_name="us-east-1")

def invoke(payload: dict, qualifier=None):
    kwargs = dict(
        agentRuntimeArn=RUNTIME_ARN,
        runtimeSessionId="sess-" + str(uuid.uuid4()) + "-" + str(uuid.uuid4()),
        payload=json.dumps(payload).encode("utf-8"),
        contentType="application/json",
        accept="application/json",
    )
    if qualifier:
        kwargs["qualifier"] = qualifier  # optional (for non-default endpoints)

    resp = rt.invoke_agent_runtime(**kwargs)
    body = resp["response"].read()
    return json.loads(body.decode("utf-8"))
