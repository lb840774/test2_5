import json
import os
import base64
import urllib.parse
import urllib.request
import urllib.error

AUTH0_DOMAIN = os.environ["AUTH0_DOMAIN"]               # e.g. dev-xxxx.us.auth0.com
AUTH0_CLIENT_ID = os.environ["AUTH0_CLIENT_ID"]
AUTH0_CLIENT_SECRET = os.environ["AUTH0_CLIENT_SECRET"]
TARGET_AUDIENCE = os.environ["TARGET_AUDIENCE"]         # e.g. https://api.addition.example.com
TARGET_SCOPE = os.environ["TARGET_SCOPE"]               # e.g. calc:add

def _decode_jwt_no_verify(token: str):
    try:
        parts = token.split(".")
        if len(parts) != 3:
            return {"warning": "not a JWT"}
        payload_b64 = parts[1] + "=" * (-len(parts[1]) % 4)
        payload = base64.urlsafe_b64decode(payload_b64.encode("utf-8"))
        return json.loads(payload.decode("utf-8"))
    except Exception as e:
        return {"warning": f"unable to decode token: {str(e)}"}

def _post_form(url: str, form: dict):
    data = urllib.parse.urlencode(form).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        body = resp.read().decode("utf-8")
        return resp.getcode(), json.loads(body)

def lambda_handler(event, context):
    print("INTERCEPTOR EVENT:", json.dumps(event))

    # AgentCore request interceptor shape
    gateway_request = event["mcp"]["gatewayRequest"]
    body = gateway_request["body"]

    if isinstance(body, str):
        body = json.loads(body)

    print("GATEWAY REQUEST BODY:", json.dumps(body))

    # MCP tools/call request structure
    # {
    #   "jsonrpc": "2.0",
    #   "id": "2",
    #   "method": "tools/call",
    #   "params": {
    #       "name": "...",
    #       "arguments": {
    #           "a": 5,
    #           "b": 3,
    #           "user_token": "..."
    #       }
    #   }
    # }
    arguments = body.get("params", {}).get("arguments", {})
    user_token = arguments.get("user_token")

    # If no user_token, just pass through unchanged
    if not user_token:
        print("No user_token provided; passing through unchanged")
        return {
            "interceptorOutputVersion": "1.0",
            "mcp": {
                "transformedGatewayRequest": {
                    "body": body
                }
            }
        }

    token_url = f"https://{AUTH0_DOMAIN}/oauth/token"

    form = {
        "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
        "client_id": AUTH0_CLIENT_ID,
        "client_secret": AUTH0_CLIENT_SECRET,
        "subject_token": user_token,
        "subject_token_type": "urn:ietf:params:oauth:token-type:access_token",
        "audience": TARGET_AUDIENCE,
        "scope": TARGET_SCOPE,
    }

    try:
        status_code, exchange_resp = _post_form(token_url, form)
        print("AUTH0 TOKEN EXCHANGE STATUS:", status_code)
        print("AUTH0 TOKEN EXCHANGE RESPONSE:", json.dumps(exchange_resp))

        exchanged_token = exchange_resp.get("access_token")
        exchanged_claims = _decode_jwt_no_verify(exchanged_token) if exchanged_token else {}
        print("EXCHANGED TOKEN CLAIMS:", json.dumps(exchanged_claims))

        # Keep request flowing unchanged for now so addNumbers still returns 8
        return {
            "interceptorOutputVersion": "1.0",
            "mcp": {
                "transformedGatewayRequest": {
                    "body": body
                }
            }
        }

    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8") if e.fp else str(e)
        print("AUTH0 HTTP ERROR:", err_body)
        raise Exception(f"Token exchange failed: HTTP {e.code} {err_body}")

    except Exception as e:
        print("GENERAL ERROR:", str(e))
        raise

Auth0’s custom token exchange uses /oauth/token and accepts a subject_token, subject_token_type, requested audience, and scope.

