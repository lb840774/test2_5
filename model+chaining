def parse_s3_uri(uri):
    assert uri.startswith("s3://")
    rest = uri[5:]
    b, _, k = rest.partition("/")
    return b, k

out_bucket, out_prefix = parse_s3_uri(out_s3)

resp = s3.list_objects_v2(Bucket=out_bucket, Prefix=out_prefix)
keys = [o["Key"] for o in resp.get("Contents", [])]
print("Output objects:", keys)

out_key = next((k for k in keys if k.endswith(".out")), keys[0])
body = s3.get_object(Bucket=out_bucket, Key=out_key)["Body"].read().decode("utf-8")

print(body[:1000])
print("\nColumns are: prediction, derived_label")

