from sklearn.preprocessing import StandardScaler

# Fit scaler on training features
scaler = StandardScaler().fit(X_train)

pre_dir = "/tmp/preprocess_model"
os.makedirs(pre_dir, exist_ok=True)
joblib.dump(scaler, f"{pre_dir}/scaler.joblib")

# Package model.tar.gz
pre_tar = "/tmp/preprocess-model.tar.gz"
with tarfile.open(pre_tar, "w:gz") as tar:
    tar.add(f"{pre_dir}/scaler.joblib", arcname="scaler.joblib")

pre_s3 = sess.upload_data(pre_tar, bucket=bucket, key_prefix=f"{prefix}/artifacts/preprocess")
print("preprocess model.tar.gz:", pre_s3)

# Inference script for sklearn container
pre_src_dir = "/tmp/preprocess_src"
os.makedirs(pre_src_dir, exist_ok=True)
pre_entry = os.path.join(pre_src_dir, "inference.py")

with open(pre_entry, "w") as f:
    f.write(r"""
import io
import joblib
import pandas as pd

def model_fn(model_dir):
    return joblib.load(f"{model_dir}/scaler.joblib")

def input_fn(request_body, request_content_type):
    if request_content_type not in ("text/csv", "application/x-csv"):
        raise ValueError(f"Unsupported content type: {request_content_type}")
    s = request_body.decode("utf-8") if isinstance(request_body, (bytes, bytearray)) else request_body
    df = pd.read_csv(io.StringIO(s), header=None)
    return df.values

def predict_fn(data, model):
    return model.transform(data)

def output_fn(prediction, accept):
    if accept not in ("text/csv", "application/x-csv", "*/*"):
        raise ValueError(f"Unsupported accept type: {accept}")
    out = io.StringIO()
    pd.DataFrame(prediction).to_csv(out, header=False, index=False)
    return out.getvalue(), "text/csv"
""")

print("Wrote preprocess inference script:", pre_entry)

