from botocore.exceptions import ClientError

mpg1 = f"{run_id}-stage1-pre"
mpg2 = f"{run_id}-stage2-ll"
mpg3 = f"{run_id}-stage3-post"

def ensure_mpg(name, desc):
    try:
        sm.describe_model_package_group(ModelPackageGroupName=name)
        print("MPG exists:", name)
    except ClientError as e:
        code = e.response.get("Error", {}).get("Code", "")
        if code in ("ValidationException", "ResourceNotFound", "ResourceNotFoundException"):
            sm.create_model_package_group(
                ModelPackageGroupName=name,
                ModelPackageGroupDescription=desc,
            )
            print("Created MPG:", name)
        else:
            raise

ensure_mpg(mpg1, "Stage 1 preprocess (sklearn) - outputs scaled CSV")
ensure_mpg(mpg2, "Stage 2 predictor (Linear Learner) - outputs predictions CSV")
ensure_mpg(mpg3, "Stage 3 postprocess (sklearn) - outputs pred + label CSV")

