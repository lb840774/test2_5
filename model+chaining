import os, io, json, tarfile, time
import numpy as np
import pandas as pd
import joblib
import boto3
from sklearn.preprocessing import StandardScaler

assert "bucket" in globals() and bucket, "Define `bucket` first"
assert "key_prefix" in globals() and key_prefix, "Define `key_prefix` first"

s3 = boto3.client("s3")
run_id = f"run-{int(time.time())}"

# --- Create 10x3 training data (REQUIRED for your scaler fit) ---
np.random.seed(7)
X_train = np.random.randn(10, 3)  # 10 rows x 3 cols
scaler = StandardScaler()
scaler.fit(X_train)

# --- Local build dir ---
pre_src_dir = f"/tmp/preprocess_src_{run_id}"
os.makedirs(pre_src_dir, exist_ok=True)

# Save artifact
scaler_path = os.path.join(pre_src_dir, "scaler.joblib")
joblib.dump(scaler, scaler_path)

# --- inference.py MUST be at root of source_dir (pre_src_dir/inference.py) ---
pre_inference_py = r'''
print("### LOADED STAGE1 PREPROCESS inference.py v4 ###")

import io
import numpy as np
import pandas as pd
import joblib
import os

def model_fn(model_dir):
    # model_dir contains scaler.joblib
    scaler_path = os.path.join(model_dir, "scaler.joblib")
    scaler = joblib.load(scaler_path)
    return scaler

def input_fn(request_body, request_content_type):
    if request_content_type not in ("text/csv", "application/x-csv"):
        raise ValueError(f"Unsupported content type: {request_content_type}")
    s = request_body.decode("utf-8") if isinstance(request_body, (bytes, bytearray)) else request_body
    df = pd.read_csv(io.StringIO(s), header=None)
    return df.values

def predict_fn(data, model):
    # model is a StandardScaler
    scaled = model.transform(data)
    return scaled

def output_fn(prediction, accept):
    out = io.StringIO()
    pd.DataFrame(prediction).to_csv(out, header=False, index=False)
    return out.getvalue(), "text/csv"
'''
with open(os.path.join(pre_src_dir, "inference.py"), "w") as f:
    f.write(pre_inference_py)

# --- Build model.tar.gz with artifacts at ROOT (scaler.joblib + inference.py) ---
pre_tar_path = f"/tmp/preprocess-model-{run_id}.tar.gz"
with tarfile.open(pre_tar_path, "w:gz") as tar:
    tar.add(scaler_path, arcname="scaler.joblib")
    tar.add(os.path.join(pre_src_dir, "inference.py"), arcname="inference.py")

# --- Upload to S3 ---
pre_s3_key = f"{key_prefix}/preprocess/preprocess-model-{run_id}.tar.gz"
s3.upload_file(pre_tar_path, bucket, pre_s3_key)

stage1_model_data_url = f"s3://{bucket}/{pre_s3_key}"
print("✅ Stage1 model_data_url:", stage1_model_data_url)
print("✅ Local tar:", pre_tar_path, "size:", os.path.getsize(pre_tar_path), "bytes")
