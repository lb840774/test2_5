import boto3, os, tarfile
from urllib.parse import urlparse

MODEL_TAR_S3 = "s3://YOUR-BUCKET/YOUR-PREFIX/artifacts/postprocess/postprocess-model.tar.gz"  # <-- paste your stage3 path

def parse_s3_uri(s3_uri: str):
    p = urlparse(s3_uri)
    if p.scheme != "s3":
        raise ValueError(f"Not an s3:// URI: {s3_uri}")
    return p.netloc, p.path.lstrip("/")

bucket, key = parse_s3_uri(MODEL_TAR_S3)
