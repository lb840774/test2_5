# SKLearn serving model wrappers (AWS-managed sklearn serving image)
pre_model = SKLearnModel(
    model_data=pre_s3,
    role=role,
    entry_point="inference.py",
    source_dir=pre_src_dir,
    framework_version="1.2-1",
    sagemaker_session=sess,
)

# Linear Learner model wrapper
ll_model = Model(
    image_uri=ll_image,
    model_data=ll_estimator.model_data,
    role=role,
    sagemaker_session=sess,
)

post_model = SKLearnModel(
    model_data=post_s3,
    role=role,
    entry_point="inference.py",
    source_dir=post_src_dir,
    framework_version="1.2-1",
    sagemaker_session=sess,
)

pipeline_model_name = f"{run_id}-pipeline-model"

pipeline_model = PipelineModel(
    name=pipeline_model_name,
    role=role,
    models=[pre_model, ll_model, post_model],  # <-- 3 stages
    sagemaker_session=sess,
)

print("PipelineModel created:", pipeline_model_name)

