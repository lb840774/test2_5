# ===== CELL 5 - STAGE 3 (POSTPROCESS) =====
import os, tarfile, json
import boto3

# -------- SET THESE (EDIT) --------
S3_BUCKET = "YOUR_BUCKET_NAME"
S3_PREFIX = "YOUR/PREFIX/artifacts"   # e.g. "chain3/artifacts"
# ----------------------------------

post_dir = "/tmp/postprocess_model"
os.makedirs(post_dir, exist_ok=True)

# --- (Optional) config to help you debug in container logs ---
with open(os.path.join(post_dir, "config.txt"), "w") as f:
    f.write("stage=postprocess\nversion=v4\n")

# --- Stage 3 inference script ---
# NOTE: file MUST be at code/inference.py inside the tar
inference_py = r'''
import os, io, json
import numpy as np
import pandas as pd

def model_fn(model_dir):
    # No artifact required; postprocess uses logic only
    return {"ok": True}

def input_fn(request_body, request_content_type):
    ct = (request_content_type or "").lower()

    # CSV path (most stable for Batch Transform)
    if "text/csv" in ct:
        s = request_body.decode("utf-8") if isinstance(request_body, (bytes, bytearray)) else str(request_body)
        df = pd.read_csv(io.StringIO(s), header=None)
        return df.values

    # JSONLINES / JSON support
    if "application/jsonlines" in ct or "application/json" in ct:
        s = request_body.decode("utf-8") if isinstance(request_body, (bytes, bytearray)) else str(request_body)
        lines = [ln.strip() for ln in s.splitlines() if ln.strip()]

        # single JSON array
        if len(lines) == 1 and lines[0].startswith("["):
            obj = json.loads(lines[0])
            return np.array(obj, dtype=float)

        # jsonlines (dicts or arrays)
        arr = []
        for ln in lines:
            obj = json.loads(ln)
            if isinstance(obj, dict):
                arr.append(list(obj.values()))
            else:
                arr.append(obj)
        return np.array(arr, dtype=float)

    raise ValueError(f"Unsupported content type: {request_content_type}")

def predict_fn(data, model):
    # Example postprocess: make a binary label from first column
    x = np.asarray(data, dtype=float)
    if x.ndim == 1:
        x = x.reshape(1, -1)

    score = x[:, 0]
    label = (score >= 0.5).astype(int)

    # Return 2 columns: score,label
    out = np.column_stack([score, label])
    return out

def output_fn(prediction, accept):
    accept = (accept or "text/csv").lower()

    if "application/json" in accept or "application/jsonlines" in accept:
        # list of [score,label]
        return json.dumps(prediction.tolist()), "application/json"

    # default csv
    out = io.StringIO()
    np.savetxt(out, prediction, delimiter=",", fmt="%.6f,%d")
    return out.getvalue(), "text/csv"
'''

code_dir = os.path.join(post_dir, "code")
os.makedirs(code_dir, exist_ok=True)
with open(os.path.join(code_dir, "inference.py"), "w") as f:
    f.write(inference_py)

# --- Build model.tar.gz ---
tar_path = "/tmp/postprocess-model.tar.gz"
with tarfile.open(tar_path, "w:gz") as tar:
    tar.add(post_dir, arcname=".")

print("Built tar:", tar_path, "size:", os.path.getsize(tar_path), "bytes")

# --- Upload to S3 ---
s3 = boto3.client("s3")
post_key = f"{S3_PREFIX}/postprocess/model.tar.gz"
s3.upload_file(tar_path, S3_BUCKET, post_key)

POSTPROCESS_MODEL_DATA = f"s3://{S3_BUCKET}/{post_key}"
print("Uploaded POSTPROCESS model tar to:", POSTPROCESS_MODEL_DATA)


