import os, io, tarfile
import joblib
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler

# Fit scaler on training features
scaler = StandardScaler().fit(X_train)

# --- Save artifact
pre_dir = "/tmp/preprocess_model"
os.makedirs(pre_dir, exist_ok=True)
joblib.dump(scaler, f"{pre_dir}/scaler.joblib")

# --- Package model.tar.gz
pre_tar = "/tmp/preprocess-model.tar.gz"
with tarfile.open(pre_tar, "w:gz") as tar:
    tar.add(f"{pre_dir}/scaler.joblib", arcname="scaler.joblib")

pre_s3 = sess.upload_data(pre_tar, bucket=bucket, key_prefix=f"{prefix}/artifacts/preprocess")
print("stage1 model.tar.gz:", pre_s3)

# --- Write inference script
pre_src_dir = "/tmp/preprocess_src"
os.makedirs(pre_src_dir, exist_ok=True)
pre_entry = os.path.join(pre_src_dir, "inference.py")

inference_py = r'''
import io
import json
import joblib
import numpy as np
import pandas as pd

def model_fn(model_dir):
    return joblib.load(f"{model_dir}/scaler.joblib")

def _to_ndarray_from_csv_bytes(b):
    s = b.decode("utf-8") if isinstance(b, (bytes, bytearray)) else str(b)
    df = pd.read_csv(io.StringIO(s), header=None)
    return df.values

def _to_ndarray_from_jsonlines_bytes(b):
    s = b.decode("utf-8") if isinstance(b, (bytes, bytearray)) else str(b)
    rows = []
    for line in s.splitlines():
        line = line.strip()
        if not line:
            continue
        obj = json.loads(line)
        # Try common patterns; fall back to "first numeric in object"
        if isinstance(obj, dict):
            if "features" in obj:
                rows.append(obj["features"])
                continue
            # pick first list value or first numeric
            for v in obj.values():
                if isinstance(v, list):
                    rows.append(v)
                    break
                if isinstance(v, (int, float)):
                    rows.append([v])
                    break
        elif isinstance(obj, list):
            rows.append(obj)
    return np.array(rows, dtype=float)

def input_fn(request_body, request_content_type):
    ct = (request_content_type or "").lower()

    if "jsonlines" in ct:
        return _to_ndarray_from_jsonlines_bytes(request_body)

    # default to CSV (this is what we want for pipeline -> LinearLearner)
    if "csv" in ct or ct == "" or ct == "application/octet-stream":
        return _to_ndarray_from_csv_bytes(request_body)

    raise ValueError(f"Unsupported content type: {request_content_type}")

def predict_fn(data, model):
    # model is a fitted StandardScaler
    return model.transform(data)

def output_fn(prediction, accept):
    # IMPORTANT: Always return CSV so container 2 can parse it reliably.
    out = io.StringIO()
    pd.DataFrame(prediction).to_csv(out, header=False, index=False)
    return out.getvalue(), "text/csv"
'''

with open(pre_entry, "w") as f:
    f.write(inference_py)

print("Wrote stage1 inference script:", pre_entry)

