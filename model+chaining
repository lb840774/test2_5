# (Keeps Batch Transform + sklearn container happy)
rows = []
for i in range(10):
    # 3 numeric cols; keep it simple/stable
    rows.append([float(i), float(i + 1), float(i + 2)])

with open(os.path.join(pre_dir, "train.csv"), "w") as f:
    for r in rows:
        f.write(",".join(map(str, r)) + "\n")

# --- (Optional) config to help you debug in container logs ---
with open(os.path.join(pre_dir, "config.txt"), "w") as f:
    f.write("stage=preprocess\nversion=v4\n")

# --- Minimal sklearn inference script for Stage 1 ---
inference_py = r'''
import os, io, json
import numpy as np
import pandas as pd

def model_fn(model_dir):
    # Stage1: no real model file needed (just a passthrough/transform)
    return {"ok": True}

def input_fn(request_body, request_content_type):
    ct = (request_content_type or "").lower()
    if "text/csv" in ct:
        s = request_body.decode("utf-8") if isinstance(request_body, (bytes, bytearray)) else str(request_body)
        df = pd.read_csv(io.StringIO(s), header=None)
        return df.values
    if "application/json" in ct or "application/jsonlines" in ct:
        # jsonlines -> one json per line; accept list-of-lists too
        s = request_body.decode("utf-8") if isinstance(request_body, (bytes, bytearray)) else str(request_body)
        lines = [ln.strip() for ln in s.splitlines() if ln.strip()]
        if len(lines) == 1 and lines[0].startswith("["):
            obj = json.loads(lines[0])
            return np.array(obj, dtype=float)
        arr = []
        for ln in lines:
            obj = json.loads(ln)
            if isinstance(obj, dict):
                arr.append(list(obj.values()))
            else:
                arr.append(obj)
        return np.array(arr, dtype=float)
    raise ValueError(f"Unsupported content type: {request_content_type}")

def predict_fn(data, model):
    # Example preprocess: identity (you can replace with real preprocessing)
    return np.asarray(data, dtype=float)

def output_fn(prediction, accept):
    accept = (accept or "text/csv").lower()
    if "application/json" in accept or "application/jsonlines" in accept:
        return json.dumps(prediction.tolist()), "application/json"
    out = io.StringIO()
    np.savetxt(out, prediction, delimiter=",")
    return out.getvalue(), "text/csv"
'''
code_dir = os.path.join(pre_dir, "code")
os.makedirs(code_dir, exist_ok=True)
with open(os.path.join(code_dir, "inference.py"), "w") as f:
    f.write(inference_py)

# --- Build model.tar.gz ---
tar_path = "/tmp/preprocess-model.tar.gz"
with tarfile.open(tar_path, "w:gz") as tar:
    tar.add(pre_dir, arcname=".")

print("Built tar:", tar_path, "size:", os.path.getsize(tar_path), "bytes")

# --- Upload to S3 ---
s3 = boto3.client("s3")
pre_key = f"{S3_PREFIX}/preprocess/model.tar.gz"
s3.upload_file(tar_path, S3_BUCKET, pre_key)

