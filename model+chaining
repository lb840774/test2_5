import os, io, json, tarfile, time
import numpy as np
import pandas as pd
import boto3

assert "bucket" in globals() and bucket, "Define `bucket` first"
assert "key_prefix" in globals() and key_prefix, "Define `key_prefix` first"

s3 = boto3.client("s3")
run_id = f"run-{int(time.time())}"

# --- Local build dir ---
post_src_dir = f"/tmp/postprocess_src_{run_id}"
os.makedirs(post_src_dir, exist_ok=True)

# --- inference.py MUST be at root of source_dir (post_src_dir/inference.py) ---
# Add a loud marker print so CloudWatch proves you’re using this exact code
post_inference_py = r'''
print("### LOADED STAGE3 POSTPROCESS inference.py v4 ###")

import io
import numpy as np
import pandas as pd

def model_fn(model_dir):
    # No model artifact needed for this simple postprocess
    return {"ok": True}

def input_fn(request_body, request_content_type):
    if request_content_type not in ("text/csv", "application/x-csv"):
        raise ValueError(f"Unsupported content type: {request_content_type}")
    s = request_body.decode("utf-8") if isinstance(request_body, (bytes, bytearray)) else request_body
    df = pd.read_csv(io.StringIO(s), header=None)
    return df.values

def predict_fn(data, model):
    # Expect stage2 output as a single numeric column (prob/score)
    preds = data[:, 0].astype(float)
    thr = float(np.median(preds)) if len(preds) else 0.0
    labels = (preds >= thr).astype(int)
    return np.column_stack([preds, labels])

def output_fn(prediction, accept):
    # Output CSV: pred,label
    out = io.StringIO()
    pd.DataFrame(prediction).to_csv(out, header=False, index=False)
    return out.getvalue(), "text/csv"
'''
with open(os.path.join(post_src_dir, "inference.py"), "w") as f:
    f.write(post_inference_py)

# --- Build model.tar.gz (can be "empty model" + inference.py at root) ---
post_tar_path = f"/tmp/postprocess-model-{run_id}.tar.gz"
with tarfile.open(post_tar_path, "w:gz") as tar:
    tar.add(os.path.join(post_src_dir, "inference.py"), arcname="inference.py")

# --- Upload to S3 ---
post_s3_key = f"{key_prefix}/postprocess/postprocess-model-{run_id}.tar.gz"
