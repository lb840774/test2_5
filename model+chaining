out_s3 = f"s3://{bucket}/{prefix}/batch_out/"

transformer = pipeline_model.transformer(
    instance_count=1,
    instance_type="ml.m5.large",
    output_path=out_s3,
    assemble_with="Line",
    accept="text/csv",
)

# This is the batch "invoke"
transformer.transform(
    data=batch_in_s3,
    content_type="text/csv",
    split_type="Line",
    wait=True,
)

print("Batch transform complete. Output prefix:", out_s3)

