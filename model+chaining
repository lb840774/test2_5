model_package_group_name = f"{run_id}-3stage-pipeline"

# Create the model package group if it doesn't exist
try:
    sm.describe_model_package_group(ModelPackageGroupName=model_package_group_name)
    print("Model Package Group exists:", model_package_group_name)
except sm.exceptions.ResourceNotFound:
    sm.create_model_package_group(
        ModelPackageGroupName=model_package_group_name,
        ModelPackageGroupDescription="3-stage batch inference pipeline: sklearn(pre) -> linear-learner -> sklearn(post)."
    )
    print("Created Model Package Group:", model_package_group_name)

# Register pipeline as ONE package (represents the whole 3-container chain)
mp = pipeline_model.register(
    content_types=["text/csv"],
    response_types=["text/csv"],
    inference_instances=["ml.m5.large"],
    transform_instances=["ml.m5.large"],
    model_package_group_name=model_package_group_name,
    approval_status="Approved",  # use "PendingManualApproval" for real governance
    description="3-stage serial pipeline (batch): preprocess -> predict -> postprocess"
)

print("Registered Model Package ARN:", mp.model_package_arn)

